PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://localhost:27017/suowmrs
JWT_SECRET=your_jwt_secret_key_here

# ── Neural Text-to-Speech (optional) ──
# Free Microsoft Edge neural voices cover en/hi/te/ta/bn with no key.
# For Odia (or-IN) add an Azure Speech key (free tier: 0.5M chars/month):
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia
# Optional voice overrides, e.g. TTS_VOICE_HI=hi-IN-MadhurNeural (male)

# ── Email / SMTP (Gmail + App Password) — works locally ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=SUOWMRS Notification <you@gmail.com>

# ── Email over HTTPS (Brevo) — required on hosts that block SMTP (e.g. Render free tier) ──
# When set, all emails go through the Brevo API instead of SMTP.
# EMAIL_FROM must be a verified sender in your Brevo account.
BREVO_API_KEY=
