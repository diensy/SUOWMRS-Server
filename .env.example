PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://localhost:27017/suowmrs
JWT_SECRET=your_jwt_secret_key_here

# ── Neural Text-to-Speech (optional) ──
# Free Microsoft Edge neural voices cover en/hi/te/ta/bn with no key.
# For Odia (or-IN) add an Azure Speech key (free tier: 0.5M chars/month):
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia
# Optional voice overrides, e.g. TTS_VOICE_HI=hi-IN-MadhurNeural (male)

# ── Email (Brevo HTTPS API) ──
# Get an API key at brevo.com → SMTP & API → API Keys.
# BREVO_SENDER_EMAIL must be a verified sender in your Brevo account.
BREVO_API_KEY=
BREVO_SENDER_NAME=SUOWMRS
BREVO_SENDER_EMAIL=
SUPPORT_EMAIL=support@suowmrs.in
SERVICE_TEAM_EMAIL=
